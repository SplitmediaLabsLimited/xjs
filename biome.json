{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.html",
      "src/**/*.css",
      "src/**/*.scss",
      "test/**/*.js",
      "test/**/*.mjs",
      "test/**/*.html",
      "test/**/*.css",
      "test/**/*.scss",
      "!test/unit/jasmine/**",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "examples/**/*.js",
      "examples/**/*.mjs",
      "examples/**/*.html",
      "examples/**/*.css",
      "examples/**/*.scss",
      "docs/astro.config.mjs",
      "docs/src/**/*.astro",
      "docs/src/**/*.ts",
      "docs/src/**/*.js",
      "docs/src/**/*.mjs",
      "docs/src/**/*.css",
      "docs/src/**/*.scss",
      "!docs/src/content/docs/api/**",
      "!docs/src/content/docs/internals/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": "warn",
        "noStaticElementInteractions": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn"
      },
      "complexity": {
        "noStaticOnlyClass": "warn"
      },
      "correctness": {
        "useParseIntRadix": "off",
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/vite-env.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": true
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 100
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

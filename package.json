{
  "name": "xjs-framework",
  "version": "2.10.2",
  "description": "XSplit JS Framework",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "vite build --watch --config vite.config.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "examples": "node scripts/serve-examples.mjs",
    "test": "npm run test:smoke",
    "test:smoke": "npm run build && node test/smoke/package-entries.mjs && node test/smoke/browser-bundle-require.mjs && node test/smoke/app-host-apis.mjs && node test/smoke/extension-config-apis.mjs && node test/smoke/extension-window-events.mjs && node test/smoke/navbar-source.mjs && node test/smoke/xsplit-harness.mjs && node test/smoke/custom-element-fixture-coverage.mjs && node test/smoke/cdp-runner.mjs && node test/smoke/build-workflow.mjs && node test/smoke/release-workflow.mjs && node test/smoke/migration-plan.mjs && node test/smoke/docs-boundary.mjs && node test/smoke/no-legacy-dependency-references.mjs",
    "test:components": "web-test-runner --config web-test-runner.config.mjs",
    "test:legacy": "karma start --single-run --browsers Firefox",
    "test:xsplit:cdp": "node scripts/xsplit-cdp-runner.mjs",
    "test:xsplit:cdp:attached": "node scripts/xsplit-cdp-attached.mjs",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "main": "./dist/xjs.cjs",
  "module": "./dist/xjs.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/xjs.js",
  "unpkg": "./dist/xjs.min.js",
  "jsdelivr": "./dist/xjs.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/xjs.mjs",
      "require": "./dist/xjs.cjs",
      "default": "./dist/xjs.mjs"
    },
    "./browser": "./dist/xjs.js",
    "./browser.min": "./dist/xjs.min.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@web/test-runner": "^0.20.2",
    "angular": "^1.8.3",
    "angular-animate": "^1.8.3",
    "angular-aria": "^1.8.3",
    "angular-material": "^1.2.5",
    "angular-route": "^1.8.3",
    "canonical-path": "0.0.2",
    "jasmine-core": "^2.3.4",
    "karma": "^0.13.2",
    "karma-chrome-launcher": "^0.2.0",
    "karma-firefox-launcher": "^1.3.0",
    "karma-jasmine": "^0.3.6",
    "karma-jasmine-html-reporter": "^0.1.8",
    "lodash": "^4.17.15",
    "string-to-comments": "^0.1.2",
    "typescript": "^6.0.3",
    "vite": "^7.2.0",
    "ws": "^8.20.1",
    "yargs": "^3.29.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SplitmediaLabsLimited/xjs.git"
  },
  "keywords": [
    "xsplit",
    "plugin",
    "framework"
  ],
  "author": "SplitmediaLabs, Ltd. <xjs@splitmedialabs.com>",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/SplitmediaLabsLimited/xjs/issues",
    "email": "xjs@splitmedialabs.com"
  },
  "homepage": "https://github.com/SplitmediaLabsLimited/xjs#readme",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "defs/",
    "dist/",
    "examples/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "volta": {
    "node": "20.19.0"
  }
}
